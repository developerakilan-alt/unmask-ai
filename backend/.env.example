# Unmask AI backend configuration.
# Copy this file to `.env` and fill in the values for your deployment.
# All variables are optional — sensible defaults are used when unset.

# --- Server ---
UNMASK_HOST=0.0.0.0
UNMASK_PORT=8000

# Comma-separated allowed browser origins (no trailing slash).
UNMASK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Model ---
# Hugging Face repo id for the synthetic-image detector.
UNMASK_MODEL_REPO=Organika/sdxl-detector
# Decision thresholds for P(AI): >= AI_THRESHOLD -> AI, <= REAL_THRESHOLD -> REAL.
UNMASK_AI_THRESHOLD=0.65
UNMASK_REAL_THRESHOLD=0.35

# --- Rate limiting & freemium quotas ---
# Per-IP requests per minute.
UNMASK_RATE_LIMIT=60
# Free scans per day (anonymous IP).
UNMASK_DAILY_FREE_SCANS=10
# Free scans per day for logged-in clients (X-Client-Id header).
UNMASK_DAILY_LOGGED_IN_SCANS=100

# --- Face check ---
UNMASK_YUNET_MODEL=
UNMASK_FACE_MIN_SIZE=60
UNMASK_FACE_SCORE_THRESHOLD=0.6
